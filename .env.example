# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_key_here
# Optional overrides
# ELEVENLABS_FAST_MODEL=eleven_flash_v2_5
# ELEVENLABS_HQ_MODEL=eleven_multilingual_v2

# Accounts (sign up / log in). Create a private Blob store with
#   vercel blob create-store mockview-accounts --access private
# then `vercel env pull .env.local`, which adds BLOB_READ_WRITE_TOKEN.
# AUTH_SECRET signs session cookies: any long random string (openssl rand -hex 32).
# AUTH_SECRET=
# BLOB_READ_WRITE_TOKEN=
